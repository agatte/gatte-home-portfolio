engine-strict=true
# @sveltejs/adapter-cloudflare@4.x peers wrangler@^3.x but the project
# pins wrangler@^4.92. The two work fine together at runtime, but npm 9+
# trips on the peer-dep mismatch under `npm ci`. Local `npm install`
# resolves it because most dev machines have legacy-peer-deps in their
# user .npmrc; codifying it here so CI matches. Drop this line once
# adapter-cloudflare ships a wrangler@^4-compatible release (tracked in
# the audit follow-ups).
legacy-peer-deps=true
